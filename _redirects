# Cloudflare Pages routing config.
# Cloudflare Pages does not read vercel.json — this file restores the same
# rewrites/redirects that vercel.json defined, now that hosting is Cloudflare Pages.
# Same-name clean URLs (e.g. /ventas -> ventas.html, /account -> account.html,
# /admin -> admin.html) already work automatically and need no entry here.

# Pretty paths used by the app shell that don't share a name with their .html file.
# Status 200 = rewrite (serves the content, keeps the URL in the address bar),
# matching vercel.json's "rewrites" behavior exactly.
/multitracks   /multitrack   200
/cuenta        /account      200

